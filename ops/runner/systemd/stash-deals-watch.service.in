[Unit]
Description=Stash deals watch job
OnFailure=stash-deals-alert@%n.service

[Service]
Type=oneshot
TimeoutStartSec=120
SyslogIdentifier=stash-deals
ExecStart=@NODE@ @CHECKOUT@/pipeline/src/jobs/run.js watch
WorkingDirectory=@CHECKOUT@
Environment=STASH_ENV=@STASH_ENV@
Environment=STASH_DRY_RUN=1
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallArchitectures=native
LockPersonality=yes
UMask=0077
StateDirectory=stash-deals
StateDirectoryMode=0700
LoadCredential=cred-gmail:@CRED_GMAIL@
