{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thestash.deals/schema/candidate-deal.schema.json",
  "title": "Stash candidate deal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_url",
    "title",
    "price",
    "merchant_domain",
    "aisle",
    "raw_subject",
    "raw_from",
    "received_at",
    "confidence",
    "needs_affiliate",
    "notes",
    "country_of_origin"
  ],
  "properties": {
    "source_url": { "type": ["string", "null"], "format": "uri" },
    "title": { "type": ["string", "null"] },
    "price": { "type": ["number", "null"] },
    "merchant_domain": { "type": ["string", "null"] },
    "aisle": {
      "type": ["string", "null"],
      "enum": [
        "guns",
        "ammo",
        "optics",
        "accessories",
        "apparel",
        "nylon",
        "food-storage",
        "survival",
        "household",
        "gaming",
        "drones",
        null
      ]
    },
    "raw_subject": { "type": ["string", "null"] },
    "raw_from": { "type": ["string", "null"] },
    "received_at": { "type": ["string", "null"], "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "needs_affiliate": { "type": "boolean" },
    "notes": { "type": "string" },
    "country_of_origin": {
      "type": ["string", "null"],
      "description": "Country where this specific firearm is manufactured. Null when the guns lookup does not verify one. Never a guess, and unused outside the guns aisle."
    }
  }
}
