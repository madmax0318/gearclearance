{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thestash.deals/schema/candidate-deal.schema.json",
  "title": "Stash candidate deal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_url",
    "title",
    "price",
    "merchant_domain",
    "aisle",
    "raw_subject",
    "raw_from",
    "received_at",
    "confidence",
    "needs_affiliate",
    "notes"
  ],
  "properties": {
    "source_url": { "type": ["string", "null"], "maxLength": 500, "pattern": "^https://[^\\s]+$" },
    "title": { "type": ["string", "null"], "maxLength": 120 },
    "price": { "type": ["number", "null"] },
    "merchant_domain": { "type": ["string", "null"], "maxLength": 253, "pattern": "^[a-z0-9.-]+$" },
    "aisle": {
      "type": ["string", "null"],
      "enum": [
        "guns",
        "ammo",
        "optics",
        "accessories",
        "apparel",
        "nylon",
        "food-storage",
        "survival",
        "household",
        "gaming",
        "drones",
        null
      ]
    },
    "raw_subject": { "type": ["string", "null"], "maxLength": 200 },
    "raw_from": { "type": ["string", "null"], "maxLength": 200 },
    "received_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "needs_affiliate": { "type": "boolean" },
    "notes": { "type": "string", "maxLength": 500 }
  }
}
