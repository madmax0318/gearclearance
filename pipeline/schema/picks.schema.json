{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thestash.deals/schema/picks.schema.json",
  "title": "Review picks",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "file_id", "ids"],
  "properties": {
    "run_id": { "type": "string", "maxLength": 40, "pattern": "^[a-z0-9-]+$" },
    "file_id": { "type": "string", "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$" },
    "ids": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^C[0-9]{2}$" }
    },
    "deferred": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^C[0-9]{2}$" }
    }
  }
}
