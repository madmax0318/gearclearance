{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thestash.deals/schema/model-output.schema.json",
  "title": "Model extraction output",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_url": { "type": ["string", "null"], "maxLength": 500 },
          "title": { "type": ["string", "null"], "maxLength": 120 },
          "price": { "type": ["number", "null"] },
          "aisle": {
            "type": ["string", "null"],
            "enum": ["guns", "ammo", "optics", "accessories", "apparel", "nylon", "food-storage", "survival", "household", "gaming", "drones", null]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
