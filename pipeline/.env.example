# Copy to pipeline/.env on Ion Cannon. Never commit the filled file.
# Publisher IDs live in Proton Pass. This process reads them from the environment only.

# IC-01 — optional local Ollama. Leave USE_OLLAMA unset or 0 for the heuristic parser.
USE_OLLAMA=0
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:35b
OLLAMA_TIMEOUT_MS=30000

# IC-03 — standing publish. Dave must grant this before it is turned on.
# Only the exact value 1 enables the gate, and review.status must still be approved.
AUTO_PUBLISH=0

# IC-02 — publisher IDs. Empty means wrap fails closed (clean URL, needs_affiliate=true).
AVANTLINK_AID=
IMPACT_PUBLISHER_ID=
CJ_PID=
AMAZON_ASSOCIATES_TAG=
