# Copy to pipeline/.env on the runner. Never commit the filled file.
# Publisher ids are read from the environment only. Empty means wrap fails closed.

# Optional local model. Leave USE_OLLAMA unset or 0 for the heuristic parser.
USE_OLLAMA=0
OLLAMA_HOST=http://127.0.0.1:<port>
OLLAMA_MODEL=<model-tag>
OLLAMA_DIGEST=<digest>
OLLAMA_TIMEOUT_MS=30000

# Standing publish. Only the exact value 1 enables the gate, and review.status must still be approved.
AUTO_PUBLISH=0

# Historical price gate. Local SQLite only. Missing history flags hist=unknown and does not block publish.
# Unset uses pipeline/data/price_history.sqlite. Create or migrate with: node src/cli.js price-history init
# PRICE_HISTORY_DB=
# Optional ammo cost-per-round enrichment. Timeouts and other failures are skipped.
AMMOSEEK_ENRICH=0

# Publisher ids. Empty means wrap fails closed (clean URL, needs_affiliate=true).
AVANTLINK_AID=
IMPACT_PUBLISHER_ID=
CJ_PID=
AMAZON_ASSOCIATES_TAG=
